# Copie para .env e preencha. O .env é gitignored e dockerignored — em produção as
# variáveis são injetadas no ambiente do container.

# --- Telegram ---
BOT_TOKEN=''
BOT_NAME='@SeuBot'
ADMIN=''
USER_TEST=''

# --- Banco (Supabase / PostgreSQL) ---
DATABASE_URL='postgresql://user:password@host:5432/postgres'
SUPABASE_PASSWORD=''

# --- LLM (Ollama, API nativa /api/chat) ---
# Deixe em branco/ausente para usar os defaults de produção definidos em src/anna/ia/config.py:
#   OLLAMA_BASE_URL  -> http://192.168.15.17:11434  (notebook-servidor)
#   OLLAMA_MODEL     -> qwen3:8b
# Para desenvolvimento com Ollama local:
OLLAMA_BASE_URL='http://localhost:11434'
OLLAMA_MODEL='qwen2.5:7b'
# Opcionais (têm default):
#   OLLAMA_TIMEOUT=300          # segundos
#   OLLAMA_KEEP_ALIVE=24h       # quanto tempo o Ollama mantém o modelo carregado
#   OLLAMA_TEMPERATURE=0.15     # baixa = extração de parâmetros mais precisa

# --- Legado (não usado pela camada ia/) ---
GEMINI_KEY=''
